{
  "Comment": "CASCADE: measure each lake month by month, route its flood to the dam, publish the dam dossier. Input: {\"start\": \"2023-09-01\", \"end\": \"2023-10-31\", \"lakes\": [\"south_lhonak\"]}",
  "StartAt": "PlanJobs",
  "States": {
    "PlanJobs": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PlanFunctionArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "lakes.$": "$.Payload.lakes",
        "items.$": "$.Payload.items"
      },
      "ResultPath": "$.plan",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "MeasureMonths"
    },
    "MeasureMonths": {
      "Type": "Map",
      "ItemsPath": "$.plan.items",
      "MaxConcurrency": 8,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "MeasureLakeMonth",
        "States": {
          "MeasureLakeMonth": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${MeasureFunctionArn}",
              "Payload.$": "$"
            },
            "OutputPath": "$.Payload",
            "TimeoutSeconds": 960,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              },
              {
                "Comment": "One retry for transient Earth Search or COG read failures.",
                "ErrorEquals": ["States.TaskFailed"],
                "IntervalSeconds": 30,
                "MaxAttempts": 1
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.error",
                "Next": "MonthFailed"
              }
            ],
            "End": true
          },
          "MonthFailed": {
            "Type": "Pass",
            "Parameters": {
              "lake_id.$": "$.lake_id",
              "start.$": "$.start",
              "status": "failed",
              "error.$": "$.error.Error"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.observations",
      "Next": "RouteFloods"
    },
    "RouteFloods": {
      "Type": "Map",
      "ItemsPath": "$.plan.lakes",
      "ItemSelector": {
        "lake_id.$": "$$.Map.Item.Value"
      },
      "MaxConcurrency": 4,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "RouteLake",
        "States": {
          "RouteLake": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${RouteFunctionArn}",
              "Payload.$": "$"
            },
            "OutputPath": "$.Payload",
            "TimeoutSeconds": 360,
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 6,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "ResultPath": "$.error",
                "Next": "RouteFailed"
              }
            ],
            "End": true
          },
          "RouteFailed": {
            "Type": "Pass",
            "Parameters": {
              "lake_id.$": "$.lake_id",
              "status": "failed",
              "error.$": "$.error.Error"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.routes",
      "Next": "PublishDossier"
    },
    "PublishDossier": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ReportFunctionArn}",
        "Payload": {
          "lakes.$": "$.plan.lakes",
          "observations.$": "$.observations",
          "routes.$": "$.routes"
        }
      },
      "ResultSelector": {
        "dossiers.$": "$.Payload.dossiers"
      },
      "ResultPath": "$.report",
      "TimeoutSeconds": 120,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 4,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PipelineFailed"
        }
      ],
      "Next": "NotifyIfRouted"
    },
    "NotifyIfRouted": {
      "Type": "Choice",
      "Comment": "A failed route has no summary to send, and a bad path in Parameters would fail the run uncatchably.",
      "Choices": [
        {
          "Variable": "$.routes[0].warning_minutes",
          "IsPresent": true,
          "Next": "NotifyDossier"
        }
      ],
      "Default": "Done"
    },
    "NotifyDossier": {
      "Type": "Task",
      "Comment": "Email the dossier summary. ResultPath null keeps the run's output unchanged.",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AlertTopicArn}",
        "Subject.$": "States.Format('CASCADE dossier: {}', $.routes[0].dam_name)",
        "Message.$": "States.Format('CASCADE published a new dossier for {}.\n\nIf {} bursts, water reaches the dam {} minutes later, peaking at {} m3/s and {} m deep.\nScenario: lake release at {}, water at the dam at {}.\n\nThis is a screening estimate, not a live warning.\nDossier page: ${SiteUrl}', $.routes[0].dam_name, $.routes[0].lake_id, $.routes[0].warning_minutes, $.routes[0].peak_m3s, $.routes[0].depth_m, $.routes[0].release_time, $.routes[0].arrival_time)"
      },
      "ResultPath": null,
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed", "States.Timeout"],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.notifyError",
          "Next": "NotifyFailed"
        }
      ],
      "End": true
    },
    "NotifyFailed": {
      "Type": "Pass",
      "Comment": "The dossier is published; only the email failed.",
      "End": true
    },
    "Done": {
      "Type": "Succeed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "ErrorPath": "$.error.Error",
      "CausePath": "$.error.Cause"
    }
  }
}
